# ensure Linux specific files are checked out with LF line endings
Dockerfile text eol=lf
*.dockerfile text eol=lf
*flatpak-lint-*.json text eol=lf
*.sh text eol=lf
# ARBS WebUI sources: LF everywhere so local and CI builds of /arbs/ are byte-identical
src_assets/common/assets/web-arbs/** text eol=lf
